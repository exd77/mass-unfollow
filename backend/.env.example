# X/Twitter API Credentials (optional — for OAuth flow)
# Get from https://developer.x.com/en/portal/dashboard
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3001/api/callback

# Session cookie (fallback — paste from browser DevTools)
# Only needed if not using OAuth
X_AUTH_TOKEN=
X_CT0=

# Server config
PORT=3001
NODE_ENV=development
